<?xml version="1.0" ?>

<launch>
    <arg name="robot_type" default="$(env ROBOT_TYPE)" doc="Robot type: [lt, go1]"/>
    <!-- This file is the single source of policy and motion paths. -->
    <arg name="policy_file_21dof"
         default="$(find rl_controllers)/policy/bumi/walkrun/N4_10500.onnx"/>
    <arg name="policy_file_12dof_walk"
         default="$(find rl_controllers)/policy/bumi/walkrandarm/policy_model3500.onnx"/>
    <arg name="policy_file_13dof_jump"
         default="$(find rl_controllers)/policy/bumi/jump/gpu118_bumi2_jump_12dof_sixdir_hardlocked_upper_model11500.onnx"/>
    <!-- mimic-lite highdynamic PPO-ROA finetune (policy[399] + command[240] -> action[21]) -->
    <arg name="policy_file_dance"
         default="$(find rl_controllers)/policy/bumi/mimic-lite/highdynamic/03-finetune_checkpoint_1000_ppo_roa_deploy.onnx"/>
    <arg name="mimic_lite_deploy_config"
         default="$(find rl_controllers)/policy/bumi/mimic-lite/highdynamic/03-finetune_checkpoint_1000_ppo_roa_deploy.deploy.json"/>
    <!-- Reference motion (bumi_deploy_motion_v1, 50 FPS) -->
    <arg name="motion_file"
         default="$(find rl_controllers)/motion_files/bumi_v2/bumi2_前手翻_30fps_onepass_deploy.json"/>

    <include file="$(find rl_controllers)/launch/joy_teleop.launch"/>
    
    <rosparam file="$(find rl_controllers)/config/$(env ROBOT_TYPE)_kd.yaml" command="load"/>
    <param name="policyFile21DOF" value="$(arg policy_file_21dof)"/>
    <param name="policyFile12DOFWalk" value="$(arg policy_file_12dof_walk)"/>
    <param name="policyFile13DOFJump" value="$(arg policy_file_13dof_jump)"/>
    <param name="policyFileDance" value="$(arg policy_file_dance)"/>
    <param name="mimicLiteDeployConfig" value="$(arg mimic_lite_deploy_config)"/>
    <param name="motionFilePath" value="$(arg motion_file)"/>
    <rosparam file="$(find rl_controllers)/config/controllers.yaml" command="load"/>
    <rosparam file="$(find rl_controllers)/config/$(env ROBOT_TYPE)_ac.yaml" command="load"/>
    <!-- 台架正弦测试参数(/bench/*)。只有编译成 AcController_bench.cpp 时才读，
         正常控制器忽略这些参数，留着不影响。 -->
    <rosparam file="$(find rl_controllers)/config/bench_params.yaml" command="load"/>

    <node name="controller_spawner" pkg="controller_manager" type="spawner" 
        respawn="false" output="screen" args="
            controllers/ac_controller"/>

    <node name="rqt_reconfigure" pkg="rqt_reconfigure" type="rqt_reconfigure" output="screen">
    </node>

    <!-- base 焊接已由 URDF 里的 legged_base_weld 插件实现(liblegged_base_weld.so),
         /walk_mode 焊接 /base_unfreeze 解除,无需额外节点 -->

</launch>

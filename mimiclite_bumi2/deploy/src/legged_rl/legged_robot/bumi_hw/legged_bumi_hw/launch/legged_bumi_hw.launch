<?xml version="1.0" ?>
<launch>
    <arg name="robot_type" default="$(env ROBOT_TYPE)" doc="Robot type: [bumi]"/>
    <arg name="description_name"   default="legged_robot_description"/>
    <param name="logFileHw" value="$(find legged_bumi_hw)/data_logs/$(arg robot_type)/log_hw.csv"/>
    
    <param name="legged_robot_description" command="$(find xacro)/xacro $(find legged_bumi_description)/urdf/bumi.urdf
    robot_type:=$(arg robot_type)
 "/>
    <node name="generate_urdf" pkg="legged_common" type="generate_urdf.sh" output="screen"
    args="$(find legged_bumi_description)/urdf/bumi.urdf $(arg robot_type)"/>

    <rosparam file="$(find rl_controllers)/config/$(arg robot_type)_kd.yaml" command="load"/>
    <rosparam file="$(find legged_bumi_hw)/config/ethercat_config.yaml" command="load"/>
    <param name="user_param_path" value="$(find legged_bumi_hw)/config/config.yaml"/>
    <param name="hardware_param_path" value="$(find legged_bumi_hw)/config/hardware.yaml"/>
    <rosparam file="$(find legged_bumi_hw)/config/$(arg robot_type).yaml" command="load"/>

    <node name="legged_bumi_hw" pkg="legged_bumi_hw" type="legged_bumi_hw" output="screen"/>

</launch>

# Copy to .local/sonic_bumi_cluster.env and fill in the two SSH endpoints.
# Never put passwords or private-key contents in this file.
GPU14_SSH="user@gpu14.example.com"
GPU14_PORT="22"
GPU15_SSH="user@gpu15.example.com"
GPU15_PORT="22"
SSH_KEY="$HOME/.ssh/id_ed25519_sonic_bumi"

# Set to YES only after the operator explicitly accepts NVIDIA's Omniverse EULA.
OMNI_KIT_ACCEPT_EULA="NO"

# Addresses visible between the two training servers.
MASTER_ADDR="10.0.0.14"
MASTER_PORT="29517"
NCCL_MASTER_PORT="29518"
NCCL_SOCKET_IFNAME="=bond4"
# Set only after an NCCL test has confirmed the exact HCA name on both nodes.
NCCL_IB_HCA=""

REMOTE_REPO="/data/user/sonic_bumi_full"
REMOTE_PYTHON="/data/user/envs/sonic_bumi/bin/python"
RUN_ROOT="/data/user/runs"
SITE_LIBRARY_DIR="/data/user/lib"
ROBOT_MOTION_DIR="/data/user/datasets/bumi3/train/robot"
SMPL_MOTION_DIR="/data/user/datasets/bumi3/train/smpl"
SMOKE_ROBOT_MOTION_DIR="/data/user/datasets/bumi3/smoke64/robot"
SMOKE_SMPL_MOTION_DIR="/data/user/datasets/bumi3/smoke64/smpl"

SMOKE_ENVS_PER_GPU="64"
SMOKE_ITERATIONS="5"
# SONIC paper setting: 4096 environments per GPU. With 16 GPUs this is 65,536.
TRAIN_ENVS_PER_GPU="4096"
TRAIN_ITERATIONS="100000"

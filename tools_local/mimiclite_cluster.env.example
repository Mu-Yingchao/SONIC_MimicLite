# Copy this file to .local/mimiclite_cluster.env and keep the copy private.
# This template intentionally contains endpoints and paths, but no private key data.

NODE0_SSH="root@118.196.95.17"
NODE0_PORT="22"
NODE0_KEY="$REPO_ROOT/.local/keys/noetix0.pem"
# Source PEM on the workstation: /home/yingchaomu/下载/Noetix-2-7.pem
NODE0_PRIVATE_IP="172.31.0.32"

NODE1_SSH="root@14.103.42.170"
NODE1_PORT="22"
NODE1_KEY="$REPO_ROOT/.local/keys/noetix9.pem"
# Source PEM on the workstation: /home/yingchaomu/下载/noetix-8.pem
NODE1_PRIVATE_IP="172.31.0.2"

GITHUB_REPO="git@github.com:Mu-Yingchao/SONIC_MimicLite.git"
REMOTE_REPO="/root/SONIC_MimicLite"
REMOTE_PYTHON="/root/SONIC_MimicLite/.venv/bin/python"
RUN_ROOT="/root/SONIC_MimicLite_runs"

# Noetix-0 is world rank 0 and rendezvous host.
MASTER_ADDR="$NODE0_PRIVATE_IP"
MASTER_PORT="29517"
NCCL_MASTER_PORT="29518"
NCCL_SOCKET_IFNAME="=eth0"
NCCL_IB_DISABLE="1"
NCCL_IB_HCA=""

# Use absolute paths that exist with identical content on both servers.
ROBOT_MOTION_DIR="/root/SONIC_MimicLite_data/robot_filtered"
SMPL_MOTION_DIR="/root/SONIC_MimicLite_data/smpl_filtered"
SMOKE_ROBOT_MOTION_DIR="/root/SONIC_MimicLite_data/smoke/robot_filtered"
SMOKE_SMPL_MOTION_DIR="/root/SONIC_MimicLite_data/smoke/smpl_filtered"

# Set YES only after the operator accepts NVIDIA's Omniverse EULA.
OMNI_KIT_ACCEPT_EULA="NO"
SMOKE_ENVS_PER_GPU="16"
SMOKE_ITERATIONS="5"
TRAIN_ENVS_PER_GPU="4096"
TRAIN_ITERATIONS="100000"
